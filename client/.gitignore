# ---------- Étape 1 : Build de l'application React/Vite ----------
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Génère les fichiers statiques optimisés dans /app/dist
RUN npm run build

# ---------- Étape 2 : Image finale légère avec Nginx ----------
FROM nginx:1.27-alpine AS production

# On retire la config par défaut de Nginx et on met la nôtre
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

# On copie uniquement les fichiers statiques buildés
COPY --from=builder /app/build /usr/share/nginx/html

# Nginx tourne en root par défaut pour bind les ports privilégiés,
# mais ici on utilise le port 5000 (non privilégié) donc on peut
# passer sur un utilisateur non-root pour plus de sécurité.
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run \
    && touch /var/run/nginx.pid \
    && chown nginx:nginx /var/run/nginx.pid

USER nginx

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://192.168.1.21:5000/health || exit 1

CMD ["nginx", "-g", "daemon off;"]